+        "articles": rows,
+        "paths": paths,
+        "axes": {"x": "density", "y": "stress"},
+        "metrics": {"source": "MONOLITH_DATA.csv"},
+    }
+    out = run_dir / "baseline_state.json"
+    out.write_text(json.dumps(payload, indent=2), encoding="utf-8")
